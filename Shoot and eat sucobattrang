--========================
-- SETTINGS
--========================
local TELEPORT_DISTANCE = 3
local TELEPORT_RESET_TIME = 10
local lastTeleportReset = 0

local MAX_EAT_PER_FRAME = 6

local EGG_INTERVAL = 0.5
local HOLD_TIME = 30
local lastEggRun = 0

--========================
-- REMOTES
--========================
local EatRemote = ReplicatedStorage
    :WaitForChild("#GAME")
    :WaitForChild("_Storage")
    :WaitForChild("Events")
    :WaitForChild("MainAttack")

--========================
-- UTILS
--========================
local holding = setmetatable({}, { __mode = "k" })
local eatenParts = setmetatable({}, { __mode = "k" })

local function getHRP()
    local char = lp.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getNPCRoot(npc)
    return npc.PrimaryPart
        or npc:FindFirstChild("HumanoidRootPart")
        or npc:FindFirstChildWhichIsA("BasePart")
end

local function freeze(model)
    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") then
            p.Anchored = true
            p.CanCollide = false
        end
    end
end

local function unfreeze(model)
    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") then
            p.Anchored = false
            p.CanCollide = true
        end
    end
end

--========================
-- SAVE LAST POSITION
--========================
task.spawn(function()
    while task.wait(0.05) do
        local hrp = getHRP()
        if hrp then
            lastCFrame = hrp.CFrame
        end
    end
end)

--========================
-- RESPAWN LOGIC
--========================
lp.CharacterAdded:Connect(function(char)
    enabled = false

    task.spawn(function()
        local hum = char:WaitForChild("Humanoid", 10)
        local hrp = char:WaitForChild("HumanoidRootPart", 10)
        if hum and hrp then
            lastCFrame = hrp.CFrame
            if autoBeforeDeath then
                enabled = true
            end
        end
    end)
end)

--========================
-- TELEPORT NPC LOOP (RESET 10s)
--========================
task.spawn(function()
    while task.wait(0.05) do
        if destroyed or not enabled then continue end

        local now = os.clock()
        if now - lastTeleportReset >= TELEPORT_RESET_TIME then
            lastTeleportReset = now
            for _, npc in ipairs(NPCFolder:GetChildren()) do
                if npc:IsA("Model") then
                    unfreeze(npc)
                end
            end
        end

        local hrp = getHRP()
        local targetCF = hrp and hrp.CFrame or lastCFrame
        if not targetCF then continue end

        for _, npc in ipairs(NPCFolder:GetChildren()) do
            if npc:IsA("Model") then
                local hum = npc:FindFirstChildOfClass("Humanoid")
                if not hum or hum.Health <= 0 then
                    unfreeze(npc)
                    continue
                end

                local root = getNPCRoot(npc)
                if not root then continue end
                npc.PrimaryPart = root

                npc:PivotTo(targetCF * CFrame.new(0, 0, -TELEPORT_DISTANCE))
                freeze(npc)
            end
        end
    end
end)

--========================
-- EQUIP WEAPON
--========================
local function equipKingSlayer()
    local char = lp.Character
    local backpack = lp:FindFirstChild("Backpack")
    if not char or not backpack then return end

    local tool = backpack:FindFirstChild("King Slayer")
    if tool and not char:FindFirstChild("King Slayer") then
        tool.Parent = char
    end
end

