-- AUTO CLICK
--========================
task.spawn(function()
    while task.wait(0.05) do
        if destroyed or not enabled then continue end
        VirtualInputManager:SendMouseButtonEvent(0,0,0,true,game,0)
        VirtualInputManager:SendMouseButtonEvent(0,0,0,false,game,0)
    end
end)

--========================
-- EAT DEAD NPC
--========================
RunService.Heartbeat:Connect(function()
    if destroyed or not enabled then return end

    equipKingSlayer()

    local origin = Camera.CFrame.Position
    local eatenThisFrame = 0

    for _, npc in ipairs(NPCFolder:GetChildren()) do
        if eatenThisFrame >= MAX_EAT_PER_FRAME then break end

        local hum = npc:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health > 0 then continue end

        for _, p in ipairs(npc:GetDescendants()) do
            if eatenThisFrame >= MAX_EAT_PER_FRAME then break end

            if p:IsA("BasePart")
            and not eatenParts[p]
            and not p:GetAttribute("IsGettingEaten") then

                eatenParts[p] = true
                local dir = p.Position - origin
                if dir.Magnitude > 0 then
EatRemote:FireServer({
    AN = "Eat",
    D = dir.Unit,
    O = origin,
    FBP = p
})
                    eatenThisFrame += 1
                end
            end
        end
    end
end)

