--========================
-- PICKUP EGGS (ALWAYS ON)
--========================
local function isEggPrompt(prompt)
    if not prompt:IsA("ProximityPrompt") then return false end
    if prompt.ActionText and string.find(string.lower(prompt.ActionText), "pick") then return true end
    if prompt.ObjectText and string.find(string.lower(prompt.ObjectText), "egg") then return true end
    return false
end

RunService.Heartbeat:Connect(function()
    if destroyed then return end

    local now = os.clock()
    if now - lastEggRun < EGG_INTERVAL then return end
    lastEggRun = now

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt")
        and isEggPrompt(obj)
        and not holding[obj] then

            holding[obj] = true
            task.spawn(function()
                pcall(function()
                    fireproximityprompt(obj, HOLD_TIME)
                end)
                task.wait(0.1)
                holding[obj] = nil
            end)
        end
    end
end)
